# copy this file to .env and fill it in
# NEVER commit .env, never screenshot it, never paste it in a group chat

# ask the facilitator privately for your team's url, keep the quotes
DATABASE_URL="paste-the-url-your-facilitator-gave-you-here"

# your team's schema name, e.g. student01 (no angle brackets, no quotes)
DB_SCHEMA=student01

PORT=3000
